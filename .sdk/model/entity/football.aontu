# Entity: football

main: kit: entity: football: {

  alias: field: {}

  fields: {
    schedule: {
      h: "Schedule"
      n: "schedule"
      r: false
      t: "`$ARRAY`"
    }
  }

  name: "football"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /sport/football/stats"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "ycOrrj2NLYdzuOBr"
                k: "query"
                n: "api_key"
                or: "api_key"
                r: true
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "league_id"
