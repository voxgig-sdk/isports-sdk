              {
                ex: "ycOrrj2NLYdzuOBr"
                k: "query"
                n: "api_key"
                or: "api_key"
                r: true
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "league_id"
                or: "league_id"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "match_id"
                or: "match_id"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/sport/football/livescores"
          q: {
            "$action": "livescore"
            exist: [
              "api_key"
              "league_id"
              "match_id"
            ]
          }
          s: [
            {
              lit: "sport"
            }
            {
              lit: "football"
            }
            {
              lit: "livescores"
            }
