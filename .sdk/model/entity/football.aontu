            res: "`body.data`"
          }
        }
        {
          co: {
            id: "GET /sport/football/schedule/basic"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "ycOrrj2NLYdzuOBr"
                k: "query"
                n: "api_key"
                or: "api_key"
                r: true
                t: "`$STRING`"
              }
              {
                ex: 1639
                k: "query"
                n: "league_id"
                or: "league_id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/sport/football/schedule/basic"
          q: {
