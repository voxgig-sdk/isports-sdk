                t: "`$STRING`"
              }
              {
                k: "query"
                n: "team_id"
                or: "team_id"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/sport/football/stats"
          q: {
            "$action": "stat"
            exist: [
              "api_key"
              "league_id"
              "season"
              "team_id"
            ]
          }
          s: [
            {
              lit: "sport"
            }
            {
              lit: "football"
            }
            {
              lit: "stats"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
        {
          co: {
            id: "GET /sport/football/livescores"
            source: "openapi3"
            version: 2
          }
          g: {
